{
  "name": "BudgetItem",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Associated project ID"
    },
    "category": {
      "type": "string",
      "description": "\u039a\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1 \u03b5\u03be\u03cc\u03b4\u03bf\u03c5"
    },
    "subcategory": {
      "type": "string",
      "description": "\u03a5\u03c0\u03bf\u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1"
    },
    "description": {
      "type": "string",
      "description": "\u03a0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae"
    },
    "quantity": {
      "type": "number",
      "description": "\u03a0\u03bf\u03c3\u03cc\u03c4\u03b7\u03c4\u03b1",
      "default": 1
    },
    "unit": {
      "type": "string",
      "description": "\u039c\u03bf\u03bd\u03ac\u03b4\u03b1 \u03bc\u03ad\u03c4\u03c1\u03b7\u03c3\u03b7\u03c2"
    },
    "unit_cost": {
      "type": "number",
      "description": "\u039a\u03cc\u03c3\u03c4\u03bf\u03c2 \u03b1\u03bd\u03ac \u03bc\u03bf\u03bd\u03ac\u03b4\u03b1 (\u20ac)"
    },
    "total_cost": {
      "type": "number",
      "description": "\u03a3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03cc \u03ba\u03cc\u03c3\u03c4\u03bf\u03c2 (\u20ac)"
    },
    "notes": {
      "type": "string",
      "description": "\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2"
    }
  },
  "required": [
    "project_id",
    "category",
    "total_cost"
  ]
}