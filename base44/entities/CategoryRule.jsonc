{
  "name": "CategoryRule",
  "type": "object",
  "properties": {
    "keyword": {
      "type": "string",
      "description": "\u039b\u03ad\u03be\u03b7-\u03ba\u03bb\u03b5\u03b9\u03b4\u03af \u03c3\u03c4\u03b7\u03bd \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae (case-insensitive)"
    },
    "category": {
      "type": "string",
      "enum": [
        "labor",
        "subcontractor",
        "materials",
        "equipment",
        "general_expenses"
      ],
      "description": "\u039a\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03b1\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af"
    },
    "subcategory": {
      "type": "string",
      "description": "\u03a0\u03c1\u03bf\u03c4\u03b5\u03b9\u03bd\u03cc\u03bc\u03b5\u03bd\u03b7 \u03c5\u03c0\u03bf\u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1 (\u03c0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03cc)"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "\u03a0\u03c1\u03bf\u03c4\u03b5\u03c1\u03b1\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03bd\u03cc\u03bd\u03b1 (\u03c5\u03c8\u03b7\u03bb\u03cc\u03c4\u03b5\u03c1\u03bf = \u03b5\u03c6\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c0\u03c1\u03ce\u03c4\u03bf)"
    }
  },
  "required": [
    "keyword",
    "category"
  ]
}