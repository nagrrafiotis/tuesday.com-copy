    "salary_amount": {
      "type": "number",
      "description": "\u03a0\u03bf\u03c3\u03cc \u03bc\u03b9\u03c3\u03b8\u03bf\u03b4\u03bf\u03c3\u03af\u03b1\u03c2 (\u20ac)"
    },
    "notes": {
      "type": "string",
      "description": "\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2"
