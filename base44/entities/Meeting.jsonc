{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Associated project ID"
    },
    "title": {
      "type": "string",
      "description": "\u03a4\u03af\u03c4\u03bb\u03bf\u03c2 \u03c3\u03c5\u03bd\u03ac\u03bd\u03c4\u03b7\u03c3\u03b7\u03c2"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1 \u03c3\u03c5\u03bd\u03ac\u03bd\u03c4\u03b7\u03c3\u03b7\u03c2"
    },
    "time": {
      "type": "string",
      "description": "\u038f\u03c1\u03b1 \u03c3\u03c5\u03bd\u03ac\u03bd\u03c4\u03b7\u03c3\u03b7\u03c2"
    },
    "location": {
      "type": "string",
      "description": "\u03a4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c3\u03af\u03b1 / \u03a3\u03cd\u03bd\u03b4\u03b5\u03c3\u03bc\u03bf\u03c2"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u03a3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2"
    },
    "topics": {
      "type": "array",
      "description": "\u0398\u03ad\u03bc\u03b1\u03c4\u03b1 \u03c3\u03c5\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7\u03c2",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "description": "\u03a0\u03b1\u03c1\u03b1\u03b4\u03bf\u03c4\u03ad\u03b1",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "\u0391\u03c0\u03bf\u03c6\u03ac\u03c3\u03b5\u03b9\u03c2 \u03bc\u03b5 \u03c7\u03c1\u03bf\u03bd\u03bf\u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03bc\u03bc\u03b1\u03c4\u03b1",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "comments": {
      "type": "array",
      "description": "\u03a3\u03c7\u03cc\u03bb\u03b9\u03b1 \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1\u03c2",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "created": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "\u0393\u03b5\u03bd\u03b9\u03ba\u03ad\u03c2 \u03c3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2"
    }
  },
  "required": [
    "project_id",
    "title",
    "date"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}