{
  "name": "BankTransaction",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1 \u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2"
    },
    "description": {
      "type": "string",
      "description": "\u03a0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae \u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2"
    },
    "amount": {
      "type": "number",
      "description": "\u03a0\u03bf\u03c3\u03cc \u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 (\u03b8\u03b5\u03c4\u03b9\u03ba\u03cc = \u03c0\u03af\u03c3\u03c4\u03c9\u03c3\u03b7, \u03b1\u03c1\u03bd\u03b7\u03c4\u03b9\u03ba\u03cc = \u03c7\u03c1\u03ad\u03c9\u03c3\u03b7)"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "credit",
        "debit"
      ],
      "description": "\u03a4\u03cd\u03c0\u03bf\u03c2 \u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2: \u03c0\u03af\u03c3\u03c4\u03c9\u03c3\u03b7 \u03ae \u03c7\u03c1\u03ad\u03c9\u03c3\u03b7"
    },
    "payment_source": {
      "type": "string",
      "description": "\u03a4\u03c1\u03ac\u03c0\u03b5\u03b6\u03b1 / \u039b\u03bf\u03b3\u03b1\u03c1\u03b9\u03b1\u03c3\u03bc\u03cc\u03c2"
    },
    "reference": {
      "type": "string",
      "description": "\u0391\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac\u03c2 / \u03c0\u03b1\u03c1\u03b1\u03c3\u03c4\u03b1\u03c4\u03b9\u03ba\u03cc"
    },
    "counterparty": {
      "type": "string",
      "description": "\u0391\u03bd\u03c4\u03b9\u03c3\u03c5\u03bc\u03b2\u03b1\u03bb\u03bb\u03cc\u03bc\u03b5\u03bd\u03bf\u03c2"
    },
    "reconciled": {
      "type": "boolean",
      "default": false,
      "description": "\u0388\u03c7\u03b5\u03b9 \u03c3\u03c5\u03bd\u03b4\u03b5\u03b8\u03b5\u03af \u03bc\u03b5 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae"
    },
    "reconciled_with": {
      "type": "string",
      "enum": [
        "payroll",
        "general_expense",
        "general_income",
        "project_expense",
        "project_income",
        "invoice",
        "other"
      ],
      "description": "\u03a4\u03cd\u03c0\u03bf\u03c2 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae\u03c2 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b4\u03ad\u03b8\u03b7\u03ba\u03b5"
    },
    "reconciled_id": {
      "type": "string",
      "description": "ID \u03c4\u03b7\u03c2 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae\u03c2 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b4\u03ad\u03b8\u03b7\u03ba\u03b5"
    },
    "reconciled_note": {
      "type": "string",
      "description": "\u03a3\u03b7\u03bc\u03b5\u03af\u03c9\u03c3\u03b7 \u03c3\u03c5\u03c3\u03c7\u03ad\u03c4\u03b9\u03c3\u03b7\u03c2"
    },
    "notes": {
      "type": "string",
      "description": "\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2"
    },
    "file_url": {
      "type": "string",
      "description": "\u0391\u03c1\u03c7\u03b5\u03af\u03bf \u03c0\u03b1\u03c1\u03b1\u03c3\u03c4\u03b1\u03c4\u03b9\u03ba\u03bf\u03cd"
    }
  },
  "required": [
    "date",
    "amount",
    "transaction_type"
  ]
}