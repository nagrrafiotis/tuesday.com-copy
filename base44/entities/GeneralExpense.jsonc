{
  "name": "GeneralExpense",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "\u03a0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae \u03b5\u03be\u03cc\u03b4\u03bf\u03c5"
    },
    "expense_type": {
      "type": "string",
      "enum": [
        "operational",
        "project"
      ],
      "default": "operational",
      "description": "\u03a4\u03cd\u03c0\u03bf\u03c2 \u03b5\u03be\u03cc\u03b4\u03bf\u03c5: \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b9\u03ba\u03cc \u03ae \u03ad\u03c1\u03b3\u03bf\u03c5"
    },
    "project_id": {
      "type": "string",
      "description": "ID \u03ad\u03c1\u03b3\u03bf\u03c5 (\u03b1\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03be\u03bf\u03b4\u03bf \u03ad\u03c1\u03b3\u03bf\u03c5)"
    },
    "project_name": {
      "type": "string",
      "description": "\u038c\u03bd\u03bf\u03bc\u03b1 \u03ad\u03c1\u03b3\u03bf\u03c5 (\u03b3\u03b9\u03b1 \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7)"
    },
    "category": {
      "type": "string",
      "description": "\u039a\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1 \u03b5\u03be\u03cc\u03b4\u03bf\u03c5"
    },
    "amount": {
      "type": "number",
      "description": "\u03a0\u03bf\u03c3\u03cc (\u20ac)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1 \u03b5\u03be\u03cc\u03b4\u03bf\u03c5"
    },
    "payment_source": {
      "type": "string",
      "description": "\u03a0\u03b7\u03b3\u03ae \u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ae\u03c2"
    },
    "payee": {
      "type": "string",
      "description": "\u0394\u03b9\u03ba\u03b1\u03b9\u03bf\u03cd\u03c7\u03bf\u03c2 / \u03a0\u03c1\u03bf\u03bc\u03b7\u03b8\u03b5\u03c5\u03c4\u03ae\u03c2"
    },
    "notes": {
      "type": "string",
      "description": "\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2"
    },
    "file_url": {
      "type": "string",
      "description": "URL \u03b1\u03c1\u03c7\u03b5\u03af\u03bf\u03c5 (\u03c0\u03b1\u03c1\u03b1\u03c3\u03c4\u03b1\u03c4\u03b9\u03ba\u03cc)"
    }
  },
  "required": [
    "description",
    "amount",
    "date"
  ]
}